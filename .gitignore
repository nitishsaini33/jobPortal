# ========================================
# SmartHire — Root .gitignore
# ========================================

# ---- OS Generated Files ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- IDE / Editor ----
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# ---- Backend (Java / Spring Boot / Maven) ----
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/uploads/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# ---- Frontend (Node / Vite / React) ----
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Environment & Secrets ----
.env
.env.*
!.env.example

# ---- Misc ----
*.tmp
*.bak
*.swp
*~
